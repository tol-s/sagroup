# Enquiry recipients (both receive every contact form submission)
CONTACT_EMAIL_1=talhasaeed687@gmail.com
CONTACT_EMAIL_2=atiqu8104@gmail.com

# Sender address. Must use a domain verified in Resend, e.g. "SA Group <enquiries@yourdomain.com>".
# "onboarding@resend.dev" only delivers to the email that owns the Resend account.
EMAIL_FROM=

# Resend API key (https://resend.com/api-keys). Server-side only. Never commit a real key.
RESEND_API_KEY=

# Optional: public URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://sagroup.vercel.app
